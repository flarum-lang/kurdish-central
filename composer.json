{
	"name": "flarum-lang/kurdish-central",
	"description": "Kurdish (Central) Language Pack for Flarum",
	"type": "flarum-extension",
	"keywords": [
		"flarum-locale"
	],
	"homepage": "https://github.com/flarum-lang/kurdish-central",
	"license": "MIT",
	"support": {
		"issues": "https://github.com/flarum-lang/kurdish-central/issues",
		"forum": "https://discuss.flarum.org/d/40178",
		"source": "https://github.com/flarum-lang/kurdish-central"
	},
	"require": {
		"flarum/core": "^2.0"
	},
	"extra": {
		"flarum-extension": {
			"title": "Kurdish (Central)",
			"category": "language",
			"icon": {
				"image": "icon.svg",
				"backgroundSize": "cover",
				"backgroundPosition": "center"
			}
		},
		"flarum-locale": {
			"code": "ckb",
			"title": "Kurdish (Central)",
			"direction": "rtl"
		}
	}
}
